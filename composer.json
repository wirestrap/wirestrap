{
  "name": "wirestrap/wirestrap",
  "description": "Anonymous Blade components for Laravel Livewire.",
  "keywords": [
    "laravel",
    "livewire",
    "blade",
    "components",
    "alpine",
    "ui",
    "forms"
  ],
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Damien FOSSEY",
      "email": "fosseyd.dev@proton.me"
    }
  ],
  "require": {
    "php": "^8.2",
    "livewire/livewire": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "Wirestrap\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Wirestrap\\WirestrapServiceProvider"
      ]
    }
  },
  "require-dev": {
    "laravel/framework": "^12.0",
    "larastan/larastan": "^3.9",
    "rector/rector": "^2.4",
    "laravel/pint": "^1.29",
    "orchestra/testbench": "^10.11"
  },
  "scripts": {
    "pint": "./vendor/bin/pint --parallel",
    "pint-ci": "./vendor/bin/pint --parallel --test",
    "rector": "./vendor/bin/rector --dry-run",
    "analyse": "./vendor/bin/phpstan analyse",
    "all": [
        "@pint",
        "@rector",
        "@analyse"
    ],
    "ci": [
        "@pint-ci",
        "@rector",
        "@analyse"
    ]
  }
}
